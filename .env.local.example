# Supabase (https://supabase.com/dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth
# Supabase 대시보드 → Authentication → Providers → Google 에서도 등록 필요
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 위 시크릿은 Cloudflare 환경변수(Secrets)에도 동일하게 등록:
# wrangler secret put GOOGLE_CLIENT_ID
# wrangler secret put GOOGLE_CLIENT_SECRET

# 기존 Vercel 가계부 링크(선택). 설정 시 가계부 카드에 "기존 가계부 ↗" 버튼 표시.
# NEXT_PUBLIC_ 접두사는 빌드 시 클라이언트 번들에 인라인되므로 로컬/Cloudflare 빌드 환경 모두 설정.
NEXT_PUBLIC_LEDGER_URL=https://your-ledger.vercel.app
