# Supabase (https://supabase.com/dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth
# Supabase 대시보드 → Authentication → Providers → Google 에서도 등록 필요
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 배포 환경변수 (자세한 절차는 DEPLOY.md 참고) ---
# Vercel 배포 시: 아래 4개를 Vercel 대시보드 → Project → Settings → Environment Variables에 등록
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY  (Production/Preview/Development 모두)
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET                   (Production/Preview)
#
# Cloudflare 배포 시(병행 유지): 시크릿은 wrangler secret로 등록
# wrangler secret put GOOGLE_CLIENT_ID
# wrangler secret put GOOGLE_CLIENT_SECRET
